# Loom Docker stack configuration.
# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Agents to bake into the daemon image and enable at startup
# (comma-separated). Available: claude, codex, copilot, opencode, kimi, qoder.
# zcode is desktop-app distributed and needs ZCODE_INSTALL_CMD — see
# docker/agents/zcode.sh.
AGENTS=claude,codex

# API keys — only needed for the agents you enabled. Agents without keys
# start anyway but their runs will fail (set LOOM_AGENT_STRICT_ENV=1 to make
# missing keys fatal).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# KIMI_API_KEY=
# MOONSHOT_API_KEY=

# Loom release used to build the images (default: latest).
# LOOM_VERSION=v0.1.0

# Runtime host name published to the server (default: docker).
# LOOM_MACHINE_NAME=docker

# Optional CLI version pins (default: latest).
# CLAUDE_CODE_VERSION=
# CODEX_VERSION=
# COPILOT_VERSION=
# OPENCODE_VERSION=
# QODER_VERSION=
