# Shell scripts and container build files must keep LF even on Windows
# checkouts — CRLF breaks /bin/sh, entrypoints, and heredocs in images.
*.sh text eol=lf
docker/** text eol=lf
docker-compose.yml text eol=lf
.env.example text eol=lf
# Golden snapshots are compared byte-wise by tests; keep line endings
# stable across Windows/macOS/Linux checkouts (iter3 S1 A1).
crates/cli/tests/golden/** text eol=lf
