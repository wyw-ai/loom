{
  "actor": {
    "id": "canfeng-minimax",
    "kind": "agent",
    "displayName": "canfeng-minimax",
    "_meta": {
      "createdBy": "joi-daemon",
      "providerId": "claude",
      "providerName": "Claude Code",
      "transportKind": "command"
    }
  },
  "transport": {
    "kind": "command",
    "command": "/home/canfeng/.local/bin/claude",
    "args": [
      "--bare",
      "--add-dir",
      "/home/canfeng/.joi-apps",
      "--permission-mode",
      "bypassPermissions",
      "--output-format",
      "stream-json",
      "--verbose",
      "-p"
    ],
    "env": {},
    "model": "claude-sonnet-4.6",
    "modelArgs": [
      "--model",
      "{model}"
    ],
    "session": {
      "firstRunCapture": "stdout_json:.session_id",
      "resumeArgs": [
        "--bare",
        "--add-dir",
        "/home/canfeng/.joi-apps",
        "--permission-mode",
        "bypassPermissions",
        "--output-format",
        "stream-json",
        "--verbose",
        "--resume",
        "{session_id}",
        "-p"
      ]
    },
    "outputFormat": "claude_stream_json",
    "promptVia": "args"
  },
  "autostart": true,
  "models": {
    "default": "claude-sonnet-4.6",
    "choices": [
      {
        "id": "sonnet",
        "label": "Sonnet"
      },
      {
        "id": "claude-sonnet-4.6",
        "label": "Claude Sonnet 4.6"
      }
    ]
  },
  "identity": {
    "files": {
      "identity": "identity.md",
      "soul": "soul.md"
    }
  }
}
