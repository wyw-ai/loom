{
  "actor": {
    "id": "actor_discovery",
    "kind": "agent",
    "displayName": "仓库发现",
    "_meta": {
      "createdBy": "loom-daemon",
      "providerId": "claude",
      "providerName": "Claude Code (GLM-5.1 endpoint)",
      "transportKind": "command",
      "revision": "actor_discovery@2026-05-19"
    },
    "capabilities": {
      "capabilities": [
        "artifact.publish",
        "workspace.read",
        "fact.append"
      ],
      "revision": "actor_discovery@2026-05-19"
    }
  },
  "transport": {
    "kind": "command",
    "command": "/home/canfeng/.local/bin/claude",
    "args": [
      "--bare",
      "--add-dir",
      "/home/canfeng/.loom",
      "--permission-mode",
      "bypassPermissions",
      "--output-format",
      "stream-json",
      "--verbose",
      "-p"
    ],
    "env": {
      "LOOM_NO_DAEMON": "1"
    },
    "model": "sonnet",
    "modelArgs": [
      "--model",
      "{model}"
    ],
    "session": {
      "firstRunCapture": "stdout_json:.session_id",
      "resumeArgs": [
        "--bare",
        "--add-dir",
        "/home/canfeng/.loom",
        "--permission-mode",
        "bypassPermissions",
        "--output-format",
        "stream-json",
        "--verbose",
        "--resume",
        "{session_id}",
        "-p"
      ]
    },
    "outputFormat": "claude_stream_json",
    "promptVia": "args"
  },
  "autostart": true,
  "models": {
    "default": "sonnet",
    "choices": [
      {
        "id": "sonnet",
        "label": "GLM-5.1"
      }
    ]
  },
  "identity": {
    "files": {
      "identity": "identity.md",
      "soul": "soul.md"
    }
  },
  "memory": {
    "delivery": {
      "mcp": true,
      "prompt": false
    }
  }
}
