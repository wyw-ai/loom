{
  "actor": {
    "id": "actor_examiner",
    "kind": "agent",
    "displayName": "审查员",
    "_meta": {
      "createdBy": "joi-daemon",
      "providerId": "codex",
      "providerName": "Codex CLI",
      "transportKind": "command"
    }
  },
  "transport": {
    "kind": "command",
    "command": "/bin/bash",
    "args": [
      "-lc",
      "source ~/open-proxy >/dev/null; export A1_CONFIG_DIR=/home/canfeng/.config/a1-examiner; export PATH=/home/canfeng/joi-apps/data/runtime-tools/joi-auto-dev/bin/examiner:/home/canfeng/canfeng-projects/.data/.nvm/versions/node/v24.14.1/bin:/home/canfeng/.nvm/versions/node/v24.14.1/bin:/home/canfeng/.local/bin:$PATH; exec codex exec --skip-git-repo-check --json --sandbox danger-full-access -c sandbox_workspace_write.network_access=true --add-dir /home/canfeng/.joi-apps \"$@\"",
      "joi-codex"
    ],
    "env": {
      "JOI_NO_DAEMON": "1",
      "A1_CONFIG_DIR": "/home/canfeng/.config/a1-examiner",
      "A1_EXAMINER_REAL_A1": "/home/canfeng/.local/bin/a1"
    },
    "model": "gpt-5.5",
    "modelArgs": [
      "--model",
      "{model}"
    ],
    "outputFormat": "codex_stream_json",
    "promptVia": "args",
    "timeoutMs": 900000
  },
  "autostart": true,
  "models": {
    "default": "gpt-5.5",
