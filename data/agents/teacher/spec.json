{
  "actor": {
    "id": "actor_teacher",
    "kind": "agent",
    "displayName": "老师",
    "_meta": {
      "createdBy": "loom-daemon",
      "providerId": "codex",
      "providerName": "Codex CLI",
      "transportKind": "command"
    }
  },
  "transport": {
    "kind": "command",
    "command": "/bin/bash",
    "args": [
      "-lc",
      "source ~/open-proxy >/dev/null && exec codex exec --skip-git-repo-check --json --sandbox danger-full-access -c sandbox_workspace_write.network_access=true --add-dir /home/canfeng/.loom \"$@\"",
      "loom-codex"
    ],
    "env": {
      "LOOM_NO_DAEMON": "1"
    },
    "model": "gpt-5.5",
    "modelArgs": [
      "--model",
      "{model}"
    ],
    "outputFormat": "codex_stream_json",
    "promptVia": "args"
  },
  "autostart": true,
  "models": {
    "default": "gpt-5.5",
    "choices": [
      {
        "id": "gpt-5.5",
        "label": "GPT-5.5"
      },
      {
        "id": "gpt-5.4",
        "label": "gpt-5.4"
      },
      {
        "id": "gpt-5.4-mini",
        "label": "GPT-5.4-Mini"
      },
      {
        "id": "gpt-5.3-codex",
        "label": "gpt-5.3-codex"
      },
      {
        "id": "gpt-5.3-codex-spark",
        "label": "GPT-5.3-Codex-Spark"
      },
      {
        "id": "gpt-5.2",
        "label": "gpt-5.2"
      }
    ]
  },
  "identity": {
    "files": {
      "identity": "identity.md",
      "soul": "soul.md"
    }
  }
}
