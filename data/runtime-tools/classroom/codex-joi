#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "Usage: codex-joi <new|resume> <joi-session-id> <prompt> [--model=<model>]" >&2
}

[ "$#" -ge 3 ] || { usage; exit 2; }

mode="$1"
joi_session_id="$2"
prompt="$3"
shift 3

model_args=()
for arg in "$@"; do
  case "$arg" in
    --model=*)
      model="${arg#--model=}"
      [ -n "$model" ] && model_args=(-m "$model")
      ;;
    --model)
      # Joi appends --model=<value>, but accept this form defensively.
      ;;
    *)
      ;;
  esac
done

if [ -s "$HOME/.nvm/nvm.sh" ]; then
  # shellcheck source=/dev/null
  source "$HOME/.nvm/nvm.sh" 2>/dev/null
  nvm use 24 >/dev/null 2>/dev/null
fi

if [ -s "$HOME/open-proxy" ]; then
  # `vpn --force-open` is an interactive-shell function on 187; source the
  # proxy env directly so non-interactive Joi agents get the same network.
  # shellcheck source=/dev/null
  source "$HOME/open-proxy"
fi

state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/joi-agent/codex-joi"
mkdir -p "$state_dir"
map_file="$state_dir/$joi_session_id.session"

tmp_dir="$(mktemp -d)"
log_file="$tmp_dir/codex.log"
out_file="$tmp_dir/last-message.txt"
trap 'rm -rf "$tmp_dir"' EXIT

run_codex() {
  local -a cmd
  if [ "$mode" = "resume" ] && [ -s "$map_file" ]; then
    codex_session_id="$(cat "$map_file")"
    # `codex exec resume` does not accept `--color`; only pass options shared
    # by the resume subcommand.
    cmd=(codex exec resume "${model_args[@]}" --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox --output-last-message "$out_file" "$codex_session_id" "$prompt")
  else
    cmd=(codex exec "${model_args[@]}" --skip-git-repo-check --dangerously-bypass-approvals-and-sandbox --color never --output-last-message "$out_file" "$prompt")
  fi

  set +e
  "${cmd[@]}" </dev/null >"$log_file" 2>&1
  status=$?
  set -e
  return "$status"
}

set +e
run_codex
status=$?
set -e

actual_session_id="$(grep -Eo 'session id: [0-9a-fA-F-]+' "$log_file" | awk '{print $3}' | tail -n1 || true)"
if [ -n "$actual_session_id" ]; then
  printf '%s\n' "$actual_session_id" >"$map_file"
fi

if [ -s "$out_file" ]; then
  body="$(cat "$out_file")"
else
  body="$(sed -n '/^codex$/,$p' "$log_file" | sed '1d;/^tokens used$/,$d')"
fi

printf '%s\n' "$body" | awk '
  BEGIN { done = 0 }
  {
    line = $0
    gsub(/\r/, "", line)
    sub(/^[[:space:]]*[●•][[:space:]]*/, "", line)
    if (line ~ /__JOI_DONE__|JOI_DONE/) {
      sub(/[[:space:]]*(__JOI_DONE__|JOI_DONE).*/, "", line)
      if (line !~ /^[[:space:]]*$/) print line
      done = 1
      next
    }
    if (!done) print line
  }
  END {
    if (done) print "__JOI_DONE__"
  }
'

if [ "$status" -ne 0 ]; then
  echo "[codex-joi] codex exited with status $status" >&2
  tail -80 "$log_file" >&2 || true
fi

exit "$status"
