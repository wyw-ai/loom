#!/usr/bin/env bash
set -euo pipefail

real_a1="${A1_EXAMINER_REAL_A1:-/home/canfeng/.local/bin/a1}"
if [[ ! -x "$real_a1" ]]; then
  real_a1="$(command -v a1)"
fi

if [[ "$real_a1" == "$0" ]]; then
  real_a1="/home/canfeng/.local/bin/a1"
fi

export A1_CONFIG_DIR="${A1_CONFIG_DIR:-/home/canfeng/.config/a1-examiner}"
unset HTTP_PROXY HTTPS_PROXY http_proxy https_proxy ALL_PROXY all_proxy

repo_map="${A1_EXAMINER_REPO_MAP:-/home/canfeng/joi-apps/data/runtime-tools/joi-auto-dev/bin/examiner/repo-project-map.tsv}"
args=("$@")

lookup_repo_id() {
  local repo="$1"
  [[ -f "$repo_map" ]] || return 1
  awk -F '\t' -v repo="$repo" '$1 == repo { print $2; found=1; exit } END { exit found ? 0 : 1 }' "$repo_map"
}

for i in "${!args[@]}"; do
  if [[ "${args[$i]}" == "--repo" && $((i + 1)) -lt ${#args[@]} ]]; then
    repo="${args[$((i + 1))]}"
    if [[ "$repo" == */* ]]; then
      if repo_id="$(lookup_repo_id "$repo")"; then
        args[$((i + 1))]="$repo_id"
      fi
    fi
  elif [[ "${args[$i]}" == --repo=* ]]; then
    repo="${args[$i]#--repo=}"
    if [[ "$repo" == */* ]]; then
      if repo_id="$(lookup_repo_id "$repo")"; then
        args[$i]="--repo=$repo_id"
      fi
    fi
  fi
done

exec "$real_a1" "${args[@]}"
