{
  "id": "a1-bug-fix-loop",
  "kind": "scheduler",
  "actor": {
    "id": "svc_a1_bug_fix_loop",
    "kind": "service",
    "displayName": "A1 Bug Fix Loop",
    "capabilities": {
      "capabilities": [
        "feedback.read",
        "task.candidate.emit",
        "task.ref.find"
      ],
      "revision": "a1-bug-fix-loop@2026-05-19"
    }
  },
  "autostart": false,
  "channelId": "chan_31f8fa85d909",
  "config": {
    "jobs": [
      {
        "id": "tick-candidates",
        "schedule": "*/5 * * * *",
        "source": {
          "kind": "command",
          "command": "python3",
          "args": [
            "{spec.dir}/bundle/tick-native.py"
          ],
          "timeoutMs": 180000
        },
        "scope": {
          "kind": "channel",
          "id": "chan_31f8fa85d909"
        },
        "dedupeBy": "payload_hash",
        "cursorBy": "body_hash",
        "singleInFlight": true
      }
    ],
    "contract": {
      "role": "feedback/workitem queue candidate adapter",
      "doesNotMaintain": [
        "separate task state",
        "root cause",
        "delivery assignment"
      ],
      "candidateMode": "router owns TaskRef binding and task creation"
    }
  }
}
