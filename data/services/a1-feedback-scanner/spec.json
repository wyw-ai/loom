{
  "id": "a1-feedback-scanner",
  "kind": "scheduler",
  "actor": {
    "id": "svc_a1_feedback_scanner",
    "kind": "service",
    "displayName": "A1 Feedback Scanner"
  },
  "autostart": false,
  "lifecycle": "thread_bound",
  "bind": {
    "scope": "thread",
    "auto_stop_on": ["thread.closed", "service.self_complete"]
  },
  "params_schema": {
    "required": [],
    "properties": {
      "since_hours": { "type": "integer", "default": 24 },
      "a1_filter": { "type": "string", "default": "" }
    }
  },
  "config": {
    "jobs": [
      {
        "id": "scan",
        "schedule": "0 * * * *",
        "source": {
          "kind": "command",
          "command": "bash",
          "args": [
            "{spec.dir}/bundle/scan.sh",
            "--state-dir",
            "{instance.data_dir}",
            "--since-hours",
            "{params.since_hours}"
          ],
          "timeoutMs": 300000
        },
        "scope": {
          "kind": "thread",
          "id": "{thread.id}",
          "channelId": "{channel.id}"
        },
        "dedupeBy": "source_event_id",
        "cursorBy": "body_hash",
        "singleInFlight": true,
        "emit": {
          "mode": "artifact_per_json_line",
          "artifactNameTemplate": "feedback-scan-{scan_id}-{bucket}.json",
          "statusEventType": "status.update"
        }
      }
    ]
  }
}
