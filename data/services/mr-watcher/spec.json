{
  "id": "mr-watcher",
  "kind": "scheduler",
  "actor": {
    "id": "mr-watcher",
    "kind": "service",
    "displayName": "mr-watcher（MR事实观察器）",
    "capabilities": {
      "capabilities": [
        "platform.mr.read",
        "fact.append",
        "task.ref.find"
      ],
      "revision": "mr-watcher@2026-05-19"
    }
  },
  "autostart": false,
  "lifecycle": "thread_bound",
  "bind": {
    "scope": "thread",
    "auto_stop_on": [
      "thread.closed"
    ]
  },
  "params_schema": {
    "required": [
      "task_id",
      "repo",
      "mr",
      "target_key"
    ],
    "properties": {
      "task_id": {
        "type": "string"
      },
      "repo": {
        "type": "string"
      },
      "mr": {
        "type": "string"
      },
      "target_key": {
        "type": "string"
      }
    }
  },
  "config": {
    "jobs": [
      {
        "id": "poll-task",
        "schedule": "* * * * *",
        "source": {
          "kind": "command",
          "command": "python3",
          "args": [
            "{spec.dir}/bundle/poll.py",
            "--once",
            "--task-id",
            "{params.task_id}",
            "--repo",
            "{params.repo}",
            "--mr",
            "{params.mr}",
            "--target-key",
            "{params.target_key}"
          ],
          "env": {
            "MR_WATCHER_STATE_DIR": "{instance.data_dir}",
            "LOOM_BIN": "/home/canfeng/loom-apps/loom",
            "LOOM_SERVER": "ws://127.0.0.1:7878/rpc",
            "A1_BIN": "/home/canfeng/.local/bin/a1",
            "HTTP_PROXY": "",
            "HTTPS_PROXY": "",
            "http_proxy": "",
            "https_proxy": "",
            "ALL_PROXY": "",
            "all_proxy": ""
          },
          "timeoutMs": 180000
        },
        "scope": {
          "kind": "thread",
          "id": "{thread.id}",
          "channelId": "{channel.id}"
        },
        "dedupeBy": "payload_hash",
        "cursorBy": "body_hash",
        "singleInFlight": true
      }
    ],
    "contract": {
      "role": "MR fact watcher",
      "writes": [
        "TaskFact target.observed",
        "TaskFact target.status_changed",
        "TaskFact target.authority_validated/invalid"
      ],
      "doesNotHandle": [
        "quality judgement",
        "design judgement",
        "direct wake message",
        "delivery/examiner assignment creation",
        "merge/platform decisions"
      ],
      "candidateMode": "without task_id the watcher emits a candidate event for actor_router"
    }
  }
}
