{
  "id": "mr-watcher",
  "kind": "scheduler",
  "actor": {
    "id": "mr-watcher",
    "kind": "service",
    "displayName": "mr-watcher（MR观察器）"
  },
  "autostart": false,
  "lifecycle": "thread_bound",
  "bind": {
    "scope": "thread",
    "auto_stop_on": [
      "thread.closed"
    ]
  },
  "config": {
    "jobs": [
      {
        "id": "poll-thread",
        "schedule": "* * * * *",
        "source": {
          "kind": "command",
          "command": "python3",
          "args": [
            "{spec.dir}/../../runtime-tools/joi-auto-dev/adapters/mr-watcher/poll.py",
            "--once",
            "--thread-id",
            "{thread.id}"
          ],
          "env": {
            "MR_WATCHER_STATE_DIR": "{instance.data_dir}"
          },
          "timeoutMs": 180000
        },
        "scope": {
          "kind": "thread",
          "id": "{thread.id}",
          "channelId": "{channel.id}"
        },
        "dedupeBy": "payload_hash",
        "cursorBy": "body_hash",
        "singleInFlight": true
      }
    ],
    "effectiveRuntime": "data/runtime-tools/joi-auto-dev/adapters/mr-watcher/poll.py",
    "contract": {
      "role": "MR fact watcher",
      "handles": [
        "mr comments",
        "examiner [examiner-result] comments",
        "examiner LGTM pass marker",
        "examiner quality_pass + LGTM - actor_examiner -> router merge/platform gate",
        "ci failures",
        "conflicts",
        "readyToMerge",
        "merged/closed terminal state"
      ],
      "doesNotHandle": [
        "quality judgement",
        "design dispute judgement",
        "direct delivery implementation decisions",
        "handoff delivery for examiner action_target=none",
        "handoff delivery for LGTM - actor_examiner marker",
        "merge/platform gate when latest examiner run failed or no current quality_pass exists"
      ],
      "ciCompensationSeconds": 1800
    }
  }
}
