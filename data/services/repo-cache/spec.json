{
  "id": "repo-cache",
  "kind": "scheduler",
  "actor": {
    "id": "svc_repo_cache",
    "kind": "service",
    "displayName": "Repo Cache"
  },
  "autostart": true,
  "channelId": "chan_31f8fa85d909",
  "config": {
    "jobs": [
      {
        "id": "sync-all",
        "schedule": "*/15 * * * *",
        "source": {
          "kind": "command",
          "command": "bash",
          "args": [
            "{spec.dir}/bundle/sync.sh",
            "--manifest",
            "{channel.workspace}/.loom/repos/manifest.json",
            "--cache-root",
            "{service.data_dir}/cache"
          ],
          "timeoutMs": 300000
        },
        "scope": {
          "kind": "channel",
          "id": "chan_31f8fa85d909"
        },
        "dedupeBy": "payload_hash",
        "cursorBy": "body_hash",
        "singleInFlight": true
      }
    ]
  }
}
