{
  "id": "repo-notes",
  "kind": "command",
  "actor": {
    "id": "svc_repo_notes",
    "kind": "service",
    "displayName": "Repo Notes (a1 kbase mirror)"
  },
  "autostart": false,
  "channelId": "channel_repo_cache",
  "config": {
    "subcommands": {
      "pull": {
        "command": "bash",
        "args": [
          "{spec.dir}/bundle/pull.sh",
          "--repo",
          "{params.repo_id}",
          "--mirror",
          "{channel.workspace}/.loom/repos/notes/{params.repo_id}.json"
        ]
      },
      "push": {
        "command": "bash",
        "args": [
          "{spec.dir}/bundle/push.sh",
          "--repo",
          "{params.repo_id}",
          "--file",
          "{params.file}"
        ]
      },
      "verify": {
        "command": "bash",
        "args": [
          "{spec.dir}/bundle/verify.sh",
          "--repo",
          "{params.repo_id}",
          "--expected-clone-url",
          "{params.expected_clone_url}"
        ]
      }
    }
  }
}
