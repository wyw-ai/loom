{
  "id": "repo-provision",
  "kind": "command",
  "actor": {
    "id": "svc_repo_provision",
    "kind": "service",
    "displayName": "Repo Provision (thread bootstrap hook)"
  },
  "autostart": false,
  "channelId": "channel_repo_cache",
  "config": {
    "trigger": {
      "kind": "thread.bootstrap",
      "artifact": "clone-manifest.json"
    },
    "command": {
      "command": "bash",
      "args": [
        "{spec.dir}/bundle/provision.sh",
        "--manifest",
        "{trigger.artifact_path}",
        "--thread-workspace",
        "{thread.workspace}",
        "--cache-root",
        "{service://repo-cache/cache}"
      ],
      "timeoutMs": 600000
    },
    "emits": {
      "event_kind": "thread.bootstrapped",
      "artifact": "repo-provision-receipt.json"
    }
  }
}
