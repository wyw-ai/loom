{
  "actor": {
    "id": "actor_claude_nonprint",
    "kind": "agent",
    "displayName": "Claude Non-Print",
    "capabilities": {}
  },
  "transport": {
    "kind": "interactive_command",
    "command": "claude",
    "args": [],
    "env": {},
    "model": "claude-sonnet-4.6",
    "provider": {
      "kind": "claude",
      "settings": {
        "mode": "global"
      }
    },
    "interactive": {
      "session": {
        "idStrategy": "joi_uuid_per_scope",
        "newArgs": [
          "--permission-mode",
          "bypassPermissions",
          "{prompt}",
          "--session-id",
          "{session_id}"
        ],
        "resumeArgs": [
          "--permission-mode",
          "bypassPermissions",
          "{prompt}",
          "--resume",
          "{session_id}"
        ],
        "onMissing": "create",
        "onSignatureChanged": "create",
        "onResumeFailed": "fail"
      },
      "prompt": {
        "template": "{joi_envelope}",
        "completionContract": {
          "sentinel": "__JOI_DONE__",
          "instruction": "When your final user-visible answer is complete, output __JOI_DONE__ on a line by itself. Do not output anything after it."
        }
      },
      "completion": {
        "detect": "sentinel",
        "stripSentinel": true,
        "idleTimeoutMs": 60000,
        "maxTurnMs": 3600000
      },
      "output": {
        "stripAnsi": true,
        "stderr": "trace",
        "streamPartial": true
      },
      "kill": {
        "onComplete": {
          "action": "sigterm",
          "graceMs": 3000,
          "fallback": "sigkill"
        },
        "onCancel": {
          "action": "sigterm",
          "graceMs": 1000,
          "fallback": "sigkill"
        },
        "onTimeout": {
          "action": "sigkill"
        }
      }
    }
  },
  "autostart": false
}
