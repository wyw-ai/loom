{
  "detect": {
    "candidates": [
      "codex",
      "codexcli"
    ]
  },
  "displayName": "Codex CLI",
  "id": "codex",
  "models": {
    "choices": [
      {
        "id": "gpt-5.6-sol",
        "label": "GPT-5.6 Sol"
      },
      {
        "id": "gpt-5.6-terra",
        "label": "GPT-5.6 Terra"
      },
      {
        "id": "gpt-5.6-luna",
        "label": "GPT-5.6 Luna"
      },
      {
        "id": "gpt-5.5",
        "label": "GPT-5.5"
      },
      {
        "id": "gpt-5.4",
        "label": "GPT-5.4"
      },
      {
        "id": "gpt-5.4-mini",
        "label": "GPT-5.4 Mini"
      },
      {
        "id": "gpt-5.3-codex-spark",
        "label": "GPT-5.3 Codex Spark"
      }
    ],
    "default": "gpt-5.6-sol"
  },
  "modes": {
    "print": {
      "args": [
        "exec",
        "--skip-git-repo-check",
        "--json",
        "--sandbox",
        "danger-full-access",
        "-c",
        "sandbox_workspace_write.network_access=true",
        "--add-dir",
        "{agent.configDir}",
        "--add-dir",
        "{agent.skillWorkspace}",
        {
          "args": [
            "--model",
            "{model}"
          ],
          "when": "model"
        },
        {
          "args": [
            "-c",
            "model_reasoning_effort={reasoningEffort}"
          ],
          "when": "reasoningEffort"
        },
        "{prompt.full}"
      ],
      "command": "{bin}",
      "env": {
        "LOOM_NO_DAEMON": "1"
      },
      "session": {
        "idSource": "provider_capture",
        "resumeArgs": [
          "exec",
          "resume",
          "{session.id}",
          "--skip-git-repo-check",
          "--json",
          "--sandbox",
          "danger-full-access",
          "-c",
          "sandbox_workspace_write.network_access=true",
          "--add-dir",
          "{agent.configDir}",
          "--add-dir",
          "{agent.skillWorkspace}",
          {
            "args": [
              "--model",
              "{model}"
            ],
            "when": "model"
          },
          {
            "args": [
              "-c",
              "model_reasoning_effort={reasoningEffort}"
            ],
            "when": "reasoningEffort"
          },
          "{prompt.full}"
        ],
        "scope": "actor_scope"
      },
      "stdout": {
        "capture": {
          "session": {
            "mode": "lastNonEmpty",
            "path": "$.session_id"
          }
        },
        "events": [],
        "format": "builtin",
        "name": "codex_stream_json"
      },
      "transport": "command"
    }
  },
  "schemaVersion": 1
}
