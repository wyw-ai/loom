{
  "detect": {
    "candidates": [
      "copilot",
      "copilotcli"
    ]
  },
  "displayName": "GitHub Copilot CLI",
  "id": "copilot",
  "models": {
    "choices": [
      {
        "id": "claude-sonnet-5",
        "label": "Claude Sonnet 5"
      },
      {
        "id": "auto",
        "label": "Auto"
      },
      {
        "id": "claude-sonnet-4.6",
        "label": "Claude Sonnet 4.6"
      },
      {
        "id": "claude-sonnet-4.5",
        "label": "Claude Sonnet 4.5"
      },
      {
        "id": "claude-haiku-4.5",
        "label": "Claude Haiku 4.5"
      },
      {
        "id": "claude-fable-5",
        "label": "Claude Fable 5"
      },
      {
        "id": "claude-opus-4.8",
        "label": "Claude Opus 4.8"
      },
      {
        "id": "claude-opus-4.8-fast",
        "label": "Claude Opus 4.8 (fast mode)"
      },
      {
        "id": "claude-opus-4.7",
        "label": "Claude Opus 4.7"
      },
      {
        "id": "claude-opus-4.6",
        "label": "Claude Opus 4.6"
      },
      {
        "id": "claude-opus-4.5",
        "label": "Claude Opus 4.5"
      },
      {
        "id": "gpt-5.6-sol",
        "label": "GPT-5.6 Sol"
      },
      {
        "id": "gpt-5.6-terra",
        "label": "GPT-5.6 Terra"
      },
      {
        "id": "gpt-5.6-luna",
        "label": "GPT-5.6 Luna"
      },
      {
        "id": "gpt-5.5",
        "label": "GPT-5.5"
      },
      {
        "id": "gpt-5.4",
        "label": "GPT-5.4"
      },
      {
        "id": "gpt-5.3-codex",
        "label": "GPT-5.3 Codex"
      },
      {
        "id": "gpt-5.4-mini",
        "label": "GPT-5.4 Mini"
      },
      {
        "id": "gpt-5-mini",
        "label": "GPT-5 Mini"
      },
      {
        "id": "gemini-3.1-pro-preview",
        "label": "Gemini 3.1 Pro"
      },
      {
        "id": "gemini-3.5-flash",
        "label": "Gemini 3.5 Flash"
      },
      {
        "id": "kimi-k2.7-code",
        "label": "Kimi K2.7 Code"
      }
    ],
    "default": "claude-sonnet-5"
  },
  "modes": {
    "print": {
      "args": [
        "--add-dir",
        "{agent.configDir}",
        "--add-dir",
        "{agent.skillWorkspace}",
        "--yolo",
        "--output-format",
        "json",
        "--stream",
        "off",
        "--resume",
        "{session.id}",
        {
          "args": [
            "--model",
            "{model}"
          ],
          "when": "model"
        },
        {
          "args": [
            "--effort",
            "{reasoningEffort}"
          ],
          "when": "reasoningEffort"
        }
      ],
      "command": "{bin}",
      "env": {
        "COPILOT_CUSTOM_INSTRUCTIONS_DIRS": "{agent.workspace}"
      },
      "stdin": "{prompt.full}",
      "session": {
        "idSource": "loom_uuid",
        "resumeArgs": [
          "--add-dir",
          "{agent.configDir}",
          "--add-dir",
          "{agent.skillWorkspace}",
          "--yolo",
          "--output-format",
          "json",
          "--stream",
          "off",
          "--resume",
          "{session.id}",
          {
            "args": [
              "--model",
              "{model}"
            ],
            "when": "model"
          },
          {
            "args": [
              "--effort",
              "{reasoningEffort}"
            ],
            "when": "reasoningEffort"
          }
        ],
        "scope": "actor_scope"
      },
      "stdout": {
        "events": [],
        "format": "jsonl",
        "reduce": {
          "finalText": {
            "fallback": {
              "mode": "concat",
              "path": "$.data.deltaContent",
              "when": {
                "all": [
                  {
                    "all": [],
                    "any": [],
                    "equals": "assistant.message_delta",
                    "path": "$.type"
                  },
                  {
                    "absentOrNull": true,
                    "all": [],
                    "any": [],
                    "path": "$.agentId"
                  },
                  {
                    "absentOrNull": true,
                    "all": [],
                    "any": [],
                    "path": "$.data.parentToolCallId"
                  }
                ],
                "any": []
              }
            },
            "mode": "lastNonEmpty",
            "path": "$.data.content",
            "when": {
              "all": [
                {
                  "all": [],
                  "any": [],
                  "equals": "assistant.message",
                  "path": "$.type"
                },
                {
                  "absentOrNull": true,
                  "all": [],
                  "any": [],
                  "path": "$.agentId"
                },
                {
                  "absentOrNull": true,
                  "all": [],
                  "any": [],
                  "path": "$.data.parentToolCallId"
                },
                {
                  "all": [],
                  "any": [],
                  "notIn": [
                    "thinking",
                    "reasoning"
                  ],
                  "path": "$.data.phase"
                }
              ],
              "any": []
            }
          }
        }
      },
      "transport": "command"
    }
  },
  "schemaVersion": 1
}
