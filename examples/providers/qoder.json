{
  "detect": {
    "candidates": [
      "qodercli"
    ]
  },
  "displayName": "Qoder CLI",
  "id": "qoder",
  "models": {
    "choices": [
      {
        "id": "auto",
        "label": "Auto"
      },
      {
        "id": "ultimate",
        "label": "Ultimate"
      },
      {
        "id": "performance",
        "label": "Performance"
      },
      {
        "id": "efficient",
        "label": "Efficient"
      },
      {
        "id": "lite",
        "label": "Lite"
      }
    ],
    "default": "auto"
  },
  "modes": {
    "print": {
      "args": [
        "--add-dir",
        "{agent.configDir}",
        "--yolo",
        "--output-format",
        "stream-json",
        {
          "args": [
            "--model",
            "{model}"
          ],
          "when": "model"
        },
        {
          "args": [
            "--reasoning-effort",
            "{reasoningEffort}"
          ],
          "when": "reasoningEffort"
        },
        "--append-system-prompt",
        "{prompt.system}",
        "-p",
        "{prompt.user}"
      ],
      "command": "{bin}",
      "prompt": {
        "outputs": {
          "full": {
            "include": [],
            "preset": "loom_full",
            "required": []
          },
          "system": {
            "include": [],
            "preset": "loom_system",
            "required": []
          },
          "user": {
            "include": [],
            "preset": "loom_turn",
            "required": []
          }
        }
      },
      "session": {
        "idSource": "provider_capture",
        "resumeArgs": [
          "--add-dir",
          "{agent.configDir}",
          "--yolo",
          "--output-format",
          "stream-json",
          {
            "args": [
              "--model",
              "{model}"
            ],
            "when": "model"
          },
          {
            "args": [
              "--reasoning-effort",
              "{reasoningEffort}"
            ],
            "when": "reasoningEffort"
          },
          "--append-system-prompt",
          "{prompt.system}",
          "--resume",
          "{session.id}",
          "-p",
          "{prompt.user}"
        ],
        "scope": "actor_scope"
      },
      "stdout": {
        "capture": {
          "session": {
            "mode": "lastNonEmpty",
            "path": "$.session_id"
          }
        },
        "events": [],
        "format": "builtin",
        "name": "claude_stream_json"
      },
      "transport": "command"
    }
  },
  "schemaVersion": 1
}
