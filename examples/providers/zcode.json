{
  "detect": {
    "candidates": [
      "/Applications/ZCode.app/Contents/Resources/glm/zcode.cjs",
      "zcode"
    ]
  },
  "displayName": "ZCode",
  "id": "zcode",
  "models": {
    "choices": [
      {
        "id": "bigmodel/glm-5.3",
        "label": "GLM-5.3 (BigModel)"
      },
      {
        "id": "bigmodel/glm-5.3-flash",
        "label": "GLM-5.3 Flash (BigModel)"
      },
      {
        "id": "bigmodel/glm-5.1-highspeed",
        "label": "GLM-5.1 Highspeed (BigModel)"
      },
      {
        "id": "bigmodel/glm-5-turbo",
        "label": "GLM-5 Turbo (BigModel)"
      },
      {
        "id": "zai/glm-5.3",
        "label": "GLM-5.3 (Z.AI)"
      },
      {
        "id": "zai/glm-5.3-flash",
        "label": "GLM-5.3 Flash (Z.AI)"
      },
      {
        "id": "zai/glm-5.1-highspeed",
        "label": "GLM-5.1 Highspeed (Z.AI)"
      },
      {
        "id": "zai/glm-5-turbo",
        "label": "GLM-5 Turbo (Z.AI)"
      }
    ],
    "default": "bigmodel/glm-5.3"
  },
  "modes": {
    "print": {
      "args": [
        "--json",
        "--prompt",
        "{prompt.full}"
      ],
      "command": "{bin}",
      "env": {
        "ZCODE_MODEL": "{model}"
      },
      "idleTimeoutMs": -1,
      "instructionsVia": "agents_md",
      "session": {
        "idSource": "provider_capture",
        "resumeArgs": [
          "--json",
          "--resume",
          "{session.id}",
          "--prompt",
          "{prompt.full}"
        ],
        "scope": "actor_scope"
      },
      "stdout": {
        "capture": {
          "session": {
            "mode": "lastNonEmpty",
            "path": "$.sessionId"
          }
        },
        "events": [],
        "format": "json",
        "reduce": {
          "finalText": {
            "mode": "lastNonEmpty",
            "path": "$.response"
          }
        }
      },
      "timeoutMs": -1,
      "transport": "command"
    }
  },
  "schemaVersion": 1
}
